# ============================================
# CONTAPYME V2 — .gitignore RAÍZ
# ============================================

# Variables de entorno (NUNCA exponer credenciales)
.env
.env.local
.env.*.local
.env.production

# Scripts de depuración locales (pueden contener credenciales — NO commitear)
scratch/
archive/scratch_legacy/
archive/engine_scratch_legacy/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
engine/.venv/
engine/__pycache__/
engine/**/__pycache__/
engine/*.pyc
engine/*.pyo

# Node.js
app/node_modules/
app/.next/
app/out/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Temporales y Logs de Auditoria/Pruebas
*.log
**/.pytest_cache/
.pytest_cache/
.coverage
*.coverage
coverage/
.nyc_output/
engine/output_images/
.agent/
.agents/
.claude/
.gemini/
supabase/.temp/
dev_tools/*/  # Ignorar scripts locales si son muy pesados o sensibles
node_modules/
dist/
build/
*.pfx
