# ============================================
# CONTAPYME V2 — .gitignore RAÍZ
# ============================================

# Variables de entorno (NUNCA exponer credenciales)
.env
.env.local
.env.*.local
.env.production

# Python
engine/.venv/
engine/__pycache__/
engine/**/__pycache__/
engine/*.pyc
engine/*.pyo

# Node.js
app/node_modules/
app/.next/
app/out/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Temporales y Logs de Auditoria/Pruebas
*.log
engine/output_images/
engine/tmp/
engine/.pytest_cache/
.agent/
.agents/
.claude/
.gemini/
dev_tools/*/  # Ignorar scripts locales si son muy pesados o sensibles
node_modules/
dist/
build/
