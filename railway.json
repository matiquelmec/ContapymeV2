{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "engine/Dockerfile",
    "context": "engine"
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port ${PORT}",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
